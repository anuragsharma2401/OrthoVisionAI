DATABASE_URL=postgresql://postgres:password@localhost:5432/orthovisionai
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORTHOVISION_UPLOAD_DIR=uploads
ORTHOVISION_MODEL_PATH=../ml/bone.pt
ORTHOVISION_PREDICTION_OUTPUT_DIR=uploads/predictions
ORTHOVISION_MAX_UPLOAD_BYTES=10485760
ORTHOVISION_MAX_REPORT_BYTES=10485760
ORTHOVISION_MODEL_IMAGE_SIZE=832
ORTHOVISION_MODEL_CONFIDENCE=0.25
ORTHOVISION_MODEL_IOU=0.35
ORTHOVISION_MODEL_MAX_DETECTIONS=10
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email OTP / Forgot Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=OrthoVision AI

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=10
AUTH_DEV_RETURN_OTP=false

# ML / uploads
ORTHOVISION_MODEL_PATH=../ml/bone.pt
ORTHOVISION_UPLOAD_DIR=uploads
ORTHOVISION_MAX_UPLOAD_BYTES=10485760
